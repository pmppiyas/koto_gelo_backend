model Group {
  id          String            @id @default(uuid()) @db.Uuid
  name        String            @db.VarChar(100)
  description String?
  type        GroupType         @default(OTHER)
  status      GroupStatus       @default(ACTIVE)
  createdById String            @db.Uuid
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  expenses    Expense[]
  deposits    GroupDeposit[]
  members     GroupMember[]
  invitations GroupInvitation[]
  createdBy   User              @relation("CreatedGroups", fields: [createdById], references: [id])

  @@index([createdById])
  @@index([type])
  @@index([status])
  @@map("groups")
}

model GroupDeposit {
  id           String        @id @default(uuid()) @db.Uuid
  groupId      String        @db.Uuid
  userId       String        @db.Uuid
  recordedById String        @db.Uuid
  amount       Decimal       @db.Decimal(12, 2)
  depositDate  DateTime      @default(now())
  method       DepositMethod @default(CASH)
  note         String?
  status       DepositStatus @default(ACTIVE)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  group        Group         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user         User          @relation("MemberDeposits", fields: [userId], references: [id], onDelete: Cascade)
  recordedBy   User          @relation("RecordedDeposits", fields: [recordedById], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@index([userId])
  @@index([depositDate])
  @@index([status])
  @@map("group_deposits")
}

model GroupMember {
  id        String            @id @default(uuid()) @db.Uuid
  groupId   String            @db.Uuid
  userId    String            @db.Uuid
  role      GroupMemberRole   @default(MEMBER)
  status    GroupMemberStatus @default(ACTIVE)
  joinedAt  DateTime          @default(now())
  leftAt    DateTime?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  group     Group             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
  @@index([groupId])
  @@index([status])
  @@map("group_members")
}

model GroupInvitation {
  id String @id @default(uuid()) @db.Uuid

  groupId String @db.Uuid
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  invitedById String @db.Uuid
  invitedBy   User   @relation("SentGroupInvitations", fields: [invitedById], references: [id], onDelete: Cascade)

  inviteeId String @db.Uuid
  invitee   User   @relation("ReceivedGroupInvitations", fields: [inviteeId], references: [id], onDelete: Cascade)

  type   GroupInvitationType   @default(INVITATION)
  status GroupInvitationStatus @default(PENDING)

  expiresAt   DateTime?
  respondedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([groupId])
  @@index([inviteeId])
  @@index([status])
  @@index([groupId, inviteeId, status])
  @@map("group_invitations")
}
